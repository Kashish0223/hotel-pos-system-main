import { findById, updateDocument, deleteDocument } from "@/lib/db-config";

export async function GET(request, { params }) {
  try {
    const table = await findById("tables", params.id);
    
    if (!table) {
      return Response.json({ error: "Table not found" }, { status: 404 });
    }
    
    return Response.json(table);
  } catch (error) {
    return Response.json({ error: "Failed to fetch table" }, { status: 500 });
  }
}

export async function PUT(request, { params }) {
  try {
    const data = await request.json();
    await updateDocument("tables", params.id, data);
    return Response.json({ success: true });
  } catch (error) {
    return Response.json({ error: "Failed to update table" }, { status: 500 });
  }
}

export async function DELETE(request, { params }) {
  try {
    await deleteDocument("tables", params.id);
    return Response.json({ success: true });
  } catch (error) {
    return Response.json({ error: "Failed to delete table" }, { status: 500 });
  }
}