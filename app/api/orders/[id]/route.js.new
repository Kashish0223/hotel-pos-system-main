import clientPromise from "@/lib/mongodb"
import { ObjectId } from "mongodb"

export async function GET(request, { params }) {
  try {
    const client = await clientPromise
    const db = client.db("hotel_pos")
    
    const order = await db.collection("orders").findOne({ 
      _id: new ObjectId(params.id) 
    })
    
    if (!order) {
      return Response.json({ error: "Order not found" }, { status: 404 })
    }
    
    return Response.json(order)
  } catch (error) {
    console.error("Error fetching order:", error)
    return Response.json({ error: "Failed to fetch order" }, { status: 500 })
  }
}

export async function PUT(request, { params }) {
  try {
    const client = await clientPromise
    const db = client.db("hotel_pos")
    const data = await request.json()

    // Get the current order to check if status is changing to completed
    const currentOrder = await db.collection("orders").findOne({ _id: new ObjectId(params.id) })
    
    // Update the order
    await db.collection("orders").updateOne(
      { _id: new ObjectId(params.id) },
      {
        $set: {
          ...data,
          updatedAt: new Date(),
        },
      },
    )

    // If the order status is being changed to "completed" and has a table number,
    // update the table status to "available"
    if (data.status === "completed" && currentOrder.status !== "completed" && currentOrder.tableNumber) {
      // Find the table by table number
      const table = await db.collection("tables").findOne({ tableNumber: currentOrder.tableNumber })
      
      if (table) {
        // Update the table status to available
        await db.collection("tables").updateOne(
          { _id: table._id },
          {
            $set: {
              status: "available",
              updatedAt: new Date(),
            },
          }
        )
      }
    }

    return Response.json({ success: true })
  } catch (error) {
    console.error("Error updating order:", error)
    return Response.json({ error: "Failed to update order" }, { status: 500 })
  }
}